# Application
APP_NAME=ESIC Backend Technical Test
APP_ENV=development
APP_DEBUG=True
APP_LOG_LEVEL=INFO

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=True

# Database
DATABASE_URL=postgresql://esic_user:esic_password@postgres:5432/esic_db
DATABASE_POOL_SIZE=20
DATABASE_POOL_RECYCLE=3600

# External Service
EXTERNAL_SERVICE_URL=http://external-service:8001
EXTERNAL_SERVICE_TIMEOUT=30

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
